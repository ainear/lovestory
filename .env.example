# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Direct) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lovestory

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=lovestory-storage
R2_PUBLIC_URL=https://storage.lovestory.app

# ── Redis (Upstash) ──
REDIS_URL=redis://localhost:6379

# ── Google Gemini AI ──
GEMINI_API_KEY=your-gemini-key

# ── SePay Payment Gateway ──
SEPAY_MERCHANT_ID=your-merchant-id
SEPAY_SECRET_KEY=your-secret-key
SEPAY_WEBHOOK_SECRET=your-webhook-secret

# ── AI (Replicate — free tier for video prototype) ──
REPLICATE_API_TOKEN=your-replicate-token

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
